<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Piootoo.Shared\Piootoo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      PrivateAssets NON include `native` (ne' `runtime`): il pacchetto porta WebView2Loader.dll
      come asset nativo, e marcarlo privato lo fa sparire dal deps.json del PUBLISH. Il file
      finisce comunque in runtimes/win-x64/native/, ma l'host .NET non dichiara mai quella
      cartella fra i percorsi di ricerca dei nativi, quindi il P/Invoke fallisce con
      "Unable to load DLL 'WebView2Loader.dll'" (0x8007007E) e il tab Report del backtest resta
      vuoto. Il build normale non lo mostrava: li' il deps.json ha ancora `runtimeTargets`.

      `compile` resta privato per non far arrivare ai consumatori (Piootoo.Strategies.Tests, che
      referenzia questo progetto) il wrapper WPF del pacchetto: e' lo stesso MSB3277 di cui parla
      il target qui sotto.
    -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44"
                      PrivateAssets="compile;build;buildtransitive;analyzers;contentfiles" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Il pacchetto Microsoft.Web.WebView2 referenzia due wrapper: quello WinForms (l'unico usato,
    in HtmlReportViewerForm) e quello WPF. Il secondo dipende da WindowsBase 5.0.0.0 di
    Microsoft.WindowsDesktop.App, mentre un progetto solo-WinForms compila contro il facade
    4.0.0.0 di Microsoft.NETCore.App: da lì l'MSB3277. Togliere il wrapper mai caricato evita di
    abilitare WPF solo per far combaciare le versioni.

    Deve girare prima di ResolveAssemblyReferences, che è il target dove il conflitto emerge.
  -->
  <Target Name="RimuoviWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference->WithMetadataValue('Filename','Microsoft.Web.WebView2.Wpf'))" />
    </ItemGroup>
  </Target>

</Project>