<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Il calendario di mercato e' un DATO, quindi il file vive con gli altri dati in
      piootoo-repository/marketdata/. Viaggia comunque dentro l'assembly: serve a test, server e
      client, e non tutti hanno un piootoo-repository/ sotto mano. LogicalName tiene fermo il nome
      della risorsa (MarketCalendarRegistry.EmbeddedResourceName) nonostante il file sia fuori dal
      progetto. Il file su disco resta come override facoltativo
      (MarketCalendarRegistry.InitializeFromSettingsFolder).
    -->
    <EmbeddedResource Include="..\piootoo-repository\marketdata\market-calendars.json"
                      LogicalName="Piootoo.Shared.MarketData.market-calendars.json" />
  </ItemGroup>

</Project>
